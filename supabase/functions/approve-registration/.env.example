# Only needed for local testing via `supabase functions serve`.
# In production, SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
# are auto-injected into every deployed Edge Function - do NOT set them with
# `supabase secrets set`, and never put the service role key in frontend/.env*.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Gmail SMTP - used to email the new owner their reference code and temp password.
# GMAIL_APP_PASSWORD is a 16-character Gmail "App Password" (Google Account ->
# Security -> 2-Step Verification -> App passwords) - NOT the account's normal
# login password; Gmail rejects SMTP auth with the login password once 2-Step
# Verification is enabled. In production, set these with `supabase secrets set`.
GMAIL_SENDER_ADDRESS=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Comma-separated list of origins allowed to call this function (CORS).
# In production, set with `supabase secrets set`.
ALLOWED_ORIGINS=http://localhost:5173
